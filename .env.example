# ID do Google Tag Manager. Sem ele, nenhum script do Google é carregado.
# O GA4 é configurado dentro do GTM, não no site.
PUBLIC_GTM_ID=GTM-PNWD6W5P
# Obsoleto: o site não lê mais PUBLIC_GA_ID. O GA4 agora é configurado dentro do GTM.
# PUBLIC_GA_ID=
# Endpoint do formulário (ex.: Formspree). Sem ele, o formulário abre o WhatsApp com a mensagem pronta.
PUBLIC_FORM_ENDPOINT=
